# Copy to .env next to config.yaml and fill in the vendors you actually want to compare.
# quickstart.sh sources this file before starting the proxy. Do not commit the filled-in copy

# The key the replay sends to the proxy, and the proxy's own master key
LITELLM_MASTER_KEY=sk-local-eval
LITELLM_API_KEY=sk-local-eval

